    "expo-keep-awake": "~57.0.2",
    "expo-sensors": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-safe-area-context": "~5.7.0",
