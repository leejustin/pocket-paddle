{
	"expo": {
		"name": "Pocket Pickle",
		"slug": "pocket-pickle",
		"version": "1.0.0",
		"orientation": "portrait",
		"userInterfaceStyle": "light",
		"icon": "./assets/icon.png",
		"splash": {
			"image": "./assets/splash.png",
			"resizeMode": "contain",
			"backgroundColor": "#f5f3e9"
		},
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "com.pocketpickle.app",
			"buildNumber": "5",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"NSLocalNetworkUsageDescription": "Pocket Pickle looks for a friend’s phone nearby so you can rally. Nothing leaves your local network.",
				"NSBonjourServices": [
					"_pocketpickle._tcp"
				]
			}
		},
		"android": {
			"package": "com.pocketpickle.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#174e38"
			},
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO"
			]
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/icon.png"
		},
		"plugins": [
			[
				"expo-sensors",
				{
					"motionPermission": "Pocket Pickle uses your phone’s motion to turn your swings into pickleball sounds. Motion stays on your device."
				}
			],
			[
				"expo-audio",
				{
					"microphonePermission": "Pocket Pickle never records audio and never asks for the microphone. Its audio library includes recording code it doesn’t use.",
					"recordAudioAndroid": false,
					"enableBackgroundPlayback": false,
					"enableBackgroundRecording": false
				}
			],
			[
				"react-native-audio-api",
				{
					"iosBackgroundMode": false,
					"androidForegroundService": false,
					"androidPermissions": [],
					"disableFFmpeg": true
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Pocket Pickle puts a photo you choose on your paddle face. It stays on this phone.",
					"cameraPermission": false,
					"microphonePermission": false
				}
			],
			"./plugins/with-scene-lifecycle.cjs",
			"./plugins/with-source-built-modules.cjs"
		]
	}
}
